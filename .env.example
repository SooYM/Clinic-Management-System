# Supabase configuration. Put credentials in local environment only.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
APP_BASE_URL=https://clinic.example.com

# Optional browser-only fixtures. Keep false for database-backed operation.
NEXT_PUBLIC_CLINIC_DEMO_MODE=false

# Server-only, independent 32-byte keys for NRIC encryption and duplicate detection.
# Generate each independently with: openssl rand -hex 32
PATIENT_NRIC_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
PATIENT_NRIC_HASH_KEY=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
DOCUMENT_QR_SIGNING_KEY=REPLACE_WITH_ANOTHER_64_HEX_CHARACTERS

# Server-only secrets; never expose these in browser bundles.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
