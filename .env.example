# Copy to .env; set local MySQL credentials. Never commit real credentials.
DATABASE_URL=mysql://clinic_app:CHANGE_ME@127.0.0.1:3306/clinic
PORT=3001
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
PUBLIC_URL=http://127.0.0.1:5173
DOCUMENT_SIGNING_KEY=CHANGE_ME_WITH_RANDOM_32_OR_MORE_CHARACTERS
# Optional legacy photo key: exactly 64 hexadecimal characters when supplied.
# Photo workflow is retired; preserve any existing key for retained historical data.
PHOTO_ENCRYPTION_KEY=
# Explicit one-time bootstrap credentials; remove after creating administrator.
BOOTSTRAP_EMAIL=admin@example.test
BOOTSTRAP_PASSWORD=CHANGE_ME_WITH_AT_LEAST_14_CHARACTERS
BOOTSTRAP_NAME=Clinic Administrator
# Optional LOCAL read-only table viewer. Never use production/root credentials.
DB_VIEWER_DATABASE_URL=mysql://clinic_viewer:CHANGE_ME@127.0.0.1:33079/clinic_dev
DB_VIEWER_PASSWORD=CHANGE_ME_WITH_RANDOM_LOCAL_VIEWER_PASSWORD
# Optional notification providers. SENT means provider acceptance, not delivery confirmation.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_LANGUAGE=en
# Approved templates each accept ONE body parameter containing notification text.
WHATSAPP_TEMPLATE_BOOKING=
WHATSAPP_TEMPLATE_ROOM_CALL=
WHATSAPP_TEMPLATE_QUEUE_NEAR=
WHATSAPP_TEMPLATE_REFILL=
