# Copy to .env.deploy on deployment host. Replace every placeholder; never commit .env.deploy.
# Generate separate random secrets; URL-encode database username/password components.
MYSQL_ROOT_PASSWORD=REPLACE_ME_WITH_SEPARATE_RANDOM_SECRET
MYSQL_MIGRATION_PASSWORD=REPLACE_ME_WITH_SEPARATE_RANDOM_SECRET
MIGRATION_DATABASE_URL=mysql://clinic_migrator:REPLACE_ME_URL_ENCODED@db:3306/clinic
DATABASE_URL=mysql://clinic_app:REPLACE_ME_URL_ENCODED@db:3306/clinic
APP_ORIGIN=https://clinic.example.com
DOCUMENT_SIGNING_KEY=REPLACE_ME_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Optional legacy key for retained photos; photo workflow is retired.
PHOTO_ENCRYPTION_KEY=
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=REPLACE_ME_WITH_RANDOM_SECRET_AT_LEAST_14_CHARACTERS
CLINIC_NAME=Clinic
# Exactly one trusted reverse proxy forwards client IP to app's loopback-only published port.
TRUST_PROXY_HOPS=1
# Bundled database is isolated on Docker's private network with no published database port.
# For remote databases use verified TLS instead and remove this plaintext exception.
DATABASE_TLS=false
ALLOW_PRIVATE_DATABASE_PLAINTEXT=true
# Optional provider secrets/templates; worker runs only with notifications profile.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_LANGUAGE=en
WHATSAPP_TEMPLATE_BOOKING=
WHATSAPP_TEMPLATE_ROOM_CALL=
WHATSAPP_TEMPLATE_QUEUE_NEAR=
WHATSAPP_TEMPLATE_REFILL=
